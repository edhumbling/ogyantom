{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/daily-devotional",
      "schedule": "0 0 * * *"
    }
  ],
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "studio",
          "format": "url",
          "env": "STUDIO_URL"
        }
      ]
    },
    "studio": {
      "root": "studio-ogya-ntom-prayer-army",
      "framework": "sanity"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
